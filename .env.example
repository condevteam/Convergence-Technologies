# Copy to .env.local and fill in. NEXT_PUBLIC_* values are inlined at build time
# (static export), so rebuild after changing them.

# Public site URL (used for canonical URLs, sitemap.xml, robots.txt, Open Graph)
NEXT_PUBLIC_SITE_URL=https://convergencetech.lk

# EmailJS (https://www.emailjs.com) – used by the Contact / Request a Quote form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
